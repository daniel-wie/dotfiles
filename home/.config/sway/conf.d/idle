# This will lock the screen after 900 seconds of inactivity,
# then turn off displays after another 900 seconds, and turn back on when resumed.
# It will also lock screen before going to sleep.

exec swayidle -w \
    timeout 900 swaylock \
    timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep swaylock
