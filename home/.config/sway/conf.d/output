# Background
output * bg $HOME/.dotfiles/img/bg.jpg fill

# You can get the names of your outputs by running: swaymsg -t get_outputs
set $laptop eDP-1
set $msi "Microstep MSI MD342CQP PC5H275200620"
set $left_14 "Dell Inc. DELL U2412M Y1H5T1B10H2L"
set $left_10 "Dell Inc. DELL P2422H 5RG92V3"
set $right_10 "Dell Inc. DELL U2424HE 4DXY3X3"

# DES
set $des_left "Dell Inc. DELL P2723QE 9S2RZ34"
set $des_right "Dell Inc. DELL P2723QE 9V2RZ34"

output $des_left resolution 3840x2160 position -3840,0
output $des_right resolution 3840x2160 position 0,0

workspace 1 output $des_left
workspace 2 output $des_left
workspace 3 output $des_left
workspace 4 output $des_left
workspace 5 output $des_left
workspace 6 output $des_right
workspace 7 output $des_right
workspace 8 output $des_right
workspace 9 output $des_right
workspace 10 output $des_right

# Homeoffice
output $laptop resolution 1920x1080 position 0,0
output $msi mode 3440x1440@120Hz position -3440,0

workspace 1 output $laptop
workspace 2 output $laptop

workspace 3 output $msi
workspace 4 output $msi
workspace 5 output $msi
workspace 6 output $msi
workspace 7 output $msi
workspace 8 output $msi
workspace 9 output $msi
workspace 10 output $msi

# AIT 
# output DP-3 resolution 1920x1080 position 1920,0
# output DP-4 resolution 1920x1080 position 3840,0

output $left_10 resolution 1920x1080 position -3840,0
output $right_10 mode 1920x1080@120Hz position -1920,0

workspace 3 output $left_10
workspace 4 output $left_10
workspace 5 output $left_10
workspace 6 output $left_10
workspace 7 output $right_10
workspace 8 output $right_10
workspace 9 output $right_10
workspace 10 output $right_10

# Clamshell mode (https://github.com/swaywm/sway/wiki#clamshell-mode)
bindswitch --reload --locked lid:on output $laptop disable
bindswitch --reload --locked lid:off output $laptop enable

